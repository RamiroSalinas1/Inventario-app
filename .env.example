# La demo y npm run build no requieren estas variables.
# Completar únicamente en .env.local, fuera del repositorio.
# Aplicación: URL pooled de una rama Neon de desarrollo autorizada.
# Usar un rol de aplicación sin propiedad de tablas ni BYPASSRLS.
DATABASE_URL=
# Drizzle Kit: URL directa, con rol de migración, de esa misma rama.
DATABASE_URL_UNPOOLED=
# Preparación de Better Auth; sus rutas permanecen deshabilitadas en esta etapa.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Herramientas de desarrollo: nunca configurar estos indicadores en producción.
# DB_DEV_HOST: hostname DIRECTO de la rama vacía autorizada, sin puerto/URL.
DB_ENV=development
DB_DEV_HOST=
# Ambas URLs PostgreSQL requieren sslmode=verify-full.
# No usar sslmode=require, sslcert/sslkey/sslrootcert ni uselibpqcompat.
