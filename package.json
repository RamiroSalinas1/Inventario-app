{
  "name": "inventario-saas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "check": "npm run lint && npm run typecheck && npm test && npm run db:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:verify": "node --experimental-strip-types scripts/db/command.ts check",
    "db:migrate:dev": "node --experimental-strip-types scripts/db/command.ts migrate",
    "db:roles:dev": "node --experimental-strip-types scripts/db/command.ts roles",
    "test:integration": "node --experimental-strip-types scripts/db/integration.ts"
  },
  "dependencies": {
    "@vercel/functions": "^3.11.0",
    "better-auth": "^1.7.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.9.10",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "24.x"
  },
  "type": "module"
}
